# All admin security headers in ONE place, so the exact same set can be applied
# at the server scope AND re-applied inside every location that sets its own
# add_header. nginx does not inherit add_header directives into a location that
# defines any add_header of its own (the cache-control / CORS blocks below do),
# so without re-including this, CSP + HSTS + framing/sniffing/referrer/permissions
# silently vanish from HTML documents, hashed assets, and config.js.
#
# Rendered by docker-entrypoint.sh (envsubst fills ${API_DOMAIN_CSP}) to
# /etc/nginx/snippets/security-headers.conf, which nginx.conf.template includes.
include /etc/nginx/snippets/security-headers-common.conf;
include /etc/nginx/snippets/security-headers-hsts.conf;
include /etc/nginx/snippets/security-headers-permissions.conf;

# Content Security Policy - dynamically configured. All three fragments are
# injected by the entrypoint (envsubst); each is either empty or a space-prefixed
# list of http(s) host-sources (API_DOMAIN_CSP/STORAGE_CSP may be http for an
# HTTP-only backend; INTEGRATION_CSP is the two fixed Jira avatar CDNs). The
# operator-supplied API/STORAGE hosts stay within their perimeter; the only fixed
# third-party origins are the Jira avatar CDNs, removed by
# DISABLE_INTEGRATION_AVATAR_CSP.
#   API_DOMAIN_CSP  - from API_DOMAIN, added to connect-src for cross-origin
#                     admin -> API deployments. Empty => only 'self'.
#   STORAGE_CSP     - from STORAGE_DOMAIN (the operator's S3/object-storage host,
#                     e.g. *.storage.yandexcloud.kz), added to img-src and
#                     connect-src for screenshots/replays. Empty => 'self'.
#   INTEGRATION_CSP - Atlassian-fixed avatar CDNs (gravatar, atl-paas) for the
#                     Jira user picker, added to img-src. On by default; set
#                     DISABLE_INTEGRATION_AVATAR_CSP=true to drop it (strict
#                     data-localized deploys that forbid third-party images).
# Note: 'unsafe-inline' is scoped to style-src only - React/Vite injects dynamic
# inline styles at runtime. The Vite production build emits no inline <script>
# (entry + config.js are external src=), so script-src stays locked to 'self'.
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:${STORAGE_CSP}${INTEGRATION_CSP}; font-src 'self' data:; connect-src 'self'${STORAGE_CSP}${API_DOMAIN_CSP}; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none';" always;

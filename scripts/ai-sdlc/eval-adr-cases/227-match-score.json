{
  "id": "227-match-score",
  "issue": 227,
  "repoCommit": "f724be9",
  "spec": "docs/specs/0227-intelligence-show-match-score-threshold-.md",
  "reference": "docs/adr/0043-intelligence-show-match-score-threshold.md",
  "derivedFrom": "Decision of ADR-0043 (Accepted). Repo state f724be9: spec merged, ADR-0043 not yet written.",
  "requireDiagram": false,
  "maxMainLines": 120,
  "required": [
    {
      "id": "admin-widget",
      "any": ["SimilarBugsWidget", "similar[- ]bugs widget", "duplicate (bug )?detail"]
    },
    {
      "id": "shows-threshold",
      "any": [
        "\\b(show|shows|showing|display|displays|displaying|render|renders|rendering|surface|surfaces)\\b[^\\n]{0,80}\\bthreshold",
        "\\bthreshold\\b[^\\n]{0,60}\\b(shown|displayed|rendered|visible)\\b"
      ]
    },
    {
      "id": "shows-score",
      "any": [
        "\\b(show|shows|showing|display|displays|displaying|render|renders|rendering|surface|surfaces)\\b[^\\n]{0,80}\\bscore",
        "\\bscore\\b[^\\n]{0,60}\\b(shown|displayed|rendered|visible)\\b"
      ]
    },
    {
      "id": "existing-similar-endpoint",
      "any": ["/similar", "existing endpoint"]
    },
    {
      "id": "no-new-endpoint-or-migration",
      "any": [
        "no (new )?(endpoint|migration)",
        "without (a |any )?(new )?(endpoint|migration)",
        "no schema change"
      ],
      "prohibition": true
    },
    {
      "id": "current-not-historical-wording",
      "any": ["current (match |similarity )?score", "current match", "similarity today", "recomput"]
    },
    {
      "id": "persistence-deferred",
      "any": [
        "\\b(persist|stor(e|ed|ing|age))[^\\n]{0,200}?(\\bdefer|separate (issue|change|slice)|follow-up|out of scope|tracked separately)",
        "(\\bdefer\\w*|out of scope)[^\\n]{0,80}\\bpersist"
      ],
      "note": "persisting the historical score, named as deferred / out of scope (a bare 'follow-up' heading does not count)"
    },
    {
      "id": "only-for-duplicates",
      "any": ["duplicate_of", "marked (as )?(a )?duplicate", "auto-closed"]
    }
  ],
  "forbidden": [
    {
      "id": "claims-original-score",
      "any": ["(shows|displays?) the (original|historical) (match )?score"]
    },
    {
      "id": "adds-migration-or-endpoint",
      "any": [
        "(add|adds|new|create|creates) (a )?migration (to|that) (store|persist)",
        "\\b(add|adds|adding|create|creates|creating) (a |one )?(new )?(DB |database |schema )?migration\\b",
        "\\b(add|adds|adding|create|creates|creating|expose|exposes|exposing|introduce|introduces|introducing) (a |one )?new (backend |API |REST |HTTP )?(endpoint|route)\\b"
      ],
      "note": "the change is UI-only and reuses the existing /similar endpoint: any new migration or endpoint is the opposite decision"
    }
  ]
}
